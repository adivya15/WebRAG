# =============================================================================
# WebRAG Backend Environment Configuration (.env)
# Create a file named `.env` inside `atlasai_backend/` and set these variables:
# =============================================================================

# 1. Groq API Key (Required for LLM Question Answering)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. ChromaDB Storage Path (Optional, defaults to ./chroma_db)
CHROMA_DB_PATH=./chroma_db

# 3. PyTorch Backend Flags (Recommended to avoid TensorFlow/Keras conflicts)
USE_TF=0
USE_TORCH=1
TF_ENABLE_ONEDNN_OPTS=0

# 4. Legacy AskHTE Settings (Optional - only if using Firebase Firestore for Knowledge Graph)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# HF_API_TOKEN=your_huggingface_read_token
